# Synchronisation cloud (optionnel). Endpoint HTTPS qui accepte un POST JSON :
# { "batchId": "uuid", "sentAt": 1234567890, "items": [ { "kind":"sale"|"stock", "createdAt", "payload" } ] }
# Sans cette variable, la file est vidée en mode démo local (latence simulée).
# VITE_CLOUD_SYNC_URL=https://api.votredomaine.com/api/caisseci/sync

# Backend fullstack (MongoDB + Prisma)
# PORT=4000
# Local MongoDB:
# DATABASE_URL="mongodb://127.0.0.1:27017/caisseci"
# MongoDB Atlas:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/caisseci?retryWrites=true&w=majority"

# Abonnements Stripe (optionnel — sans clés, l’essai gratuit et la gestion de licence fonctionnent)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=xof
# URL publique HTTPS de l’app (obligatoire en production pour Stripe/CinetPay)
# Ex. https://caisseci.onrender.com ou https://app.votredomaine.com
# APP_URL=https://votredomaine.com
#
# Pages publiques du site :
#   /           → site commercial (tarifs, inscription)
#   /tarifs     → tarifs
#   /inscription → création de compte / choix du plan
#   /staff      → connexion caissier
#   /admin      → console opérateur CaisseCI (abonnements plateforme)

# Console opérateur (page web /admin — réservée à l’équipe CaisseCI)
# PLATFORM_ADMIN_SECRET=choisissez-un-mot-de-passe-long-et-secret
# Sans cette variable, /admin affiche un message de configuration manquante.
# La CLI reste disponible : npm run admin:subscriptions

# Administration plateforme (CLI : npm run admin:subscriptions)
# Accès direct MongoDB via DATABASE_URL — réserver aux opérateurs CaisseCI.

# Mobile money Côte d’Ivoire (CinetPay — Orange Money, MTN, Moov)
# CINETPAY_API_KEY=votre_apikey
# CINETPAY_SITE_ID=votre_site_id
# CINETPAY_DEMO_MODE=true
# En local sans compte CinetPay : CINETPAY_DEMO_MODE=true active une page de simulation.

# Wave CI — paiement direct via l’API Business Wave (recommandé pour Wave)
# Obtenez vos clés sur https://business.wave.com → Développeur
# WAVE_API_KEY=wave_ci_prod_...
# WAVE_WEBHOOK_SECRET=wave_sn_WHS_...   # secret webhook (portal Wave)
# WAVE_SIGNING_SECRET=wave_sn_AKS_...   # optionnel si signature des requêtes activée
# WAVE_DEMO_MODE=true                   # simulation locale sans clé API (pas l’app Wave réelle)
# En production : renseignez WAVE_API_KEY et mettez WAVE_DEMO_MODE=false
# Le client est alors redirigé vers pay.wave.com (app Wave CI ou QR à scanner).
# Webhook à enregistrer : https://votredomaine.com/api/billing/wave/webhook
# Événements : checkout.session.completed, checkout.session.payment_failed

# SMS (rappels abonnement + commandes en ligne)
# SMS_PROVIDER_URL=https://votre-prestataire-sms.com/send
# SMS_PROVIDER_TOKEN=...
# SUBSCRIPTION_REMINDER_INTERVAL_HOURS=6

# Stockage fichiers — Vercel Blob (photos produits catalogue)
# Créez un store sur https://vercel.com/dashboard/stores puis copiez le token « Read-Write ».
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Sans ce token, les photos restent en data URL locale (IndexedDB, max 500 Ko).
