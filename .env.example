# Synchronisation cloud (optionnel). Endpoint HTTPS qui accepte un POST JSON :
# { "batchId": "uuid", "sentAt": 1234567890, "items": [ { "kind":"sale"|"stock", "createdAt", "payload" } ] }
# Sans cette variable, la file est vidée en mode démo local (latence simulée).
# VITE_CLOUD_SYNC_URL=https://api.votredomaine.com/api/caisseci/sync

# Backend fullstack (MongoDB + Prisma)
# PORT=4000
# Local MongoDB:
# DATABASE_URL="mongodb://127.0.0.1:27017/caisseci"
# MongoDB Atlas:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/caisseci?retryWrites=true&w=majority"

# Abonnements Stripe (optionnel — sans clés, l’essai gratuit et la gestion de licence fonctionnent)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=xof
# URL publique HTTPS de l’app (obligatoire en production pour Stripe/CinetPay)
# Ex. https://caisseci.onrender.com ou https://app.votredomaine.com
# APP_URL=https://votredomaine.com
#
# Pages publiques du site :
#   /           → site commercial (tarifs, inscription)
#   /tarifs     → tarifs
#   /inscription → création de compte / choix du plan
#   /staff      → connexion caissier

# Mobile money Côte d’Ivoire (CinetPay — Orange Money, Wave, MTN, Moov)
# CINETPAY_API_KEY=votre_apikey
# CINETPAY_SITE_ID=votre_site_id
# CINETPAY_DEMO_MODE=true
# En local sans compte CinetPay : CINETPAY_DEMO_MODE=true active une page de simulation.

# SMS (rappels abonnement + commandes en ligne)
# SMS_PROVIDER_URL=https://votre-prestataire-sms.com/send
# SMS_PROVIDER_TOKEN=...
# SUBSCRIPTION_REMINDER_INTERVAL_HOURS=6
