{
  "name": "caisseci",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n API,APP -c green,cyan \"npm:dev:api\" \"npm:dev\"",
    "dev:offline": "vite --mode offline",
    "dev:api": "tsx watch server/server.ts",
    "dev:kiosk": "concurrently -k -n API,APP -c green,cyan \"npm:dev:api\" \"npm:dev:offline\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "build:offline": "tsc -b && vite build --mode offline && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server-dist/server.js",
    "start:kiosk": "npm run build:offline && npm run start",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@prisma/client": "^6.8.0",
    "cors": "^2.8.5",
    "dexie": "^4.4.1",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prisma": "^6.8.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "concurrently": "^9.2.1"
  }
}
